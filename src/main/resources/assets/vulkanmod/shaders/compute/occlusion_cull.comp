#version 450

layout(local_size_x = 64) in;

layout(binding = 0) uniform sampler2D hiZ;

layout(std430, binding = 1) buffer Commands {
    uint commands[];
};

layout(std430, binding = 2) readonly buffer Sections {
    uint count;
    uint pad0;
    uint pad1;
    uint pad2;
    vec4 sections[];
};

layout(std430, binding = 3) writeonly buffer Visibility {
    uint visibility[];
};

layout(std430, binding = 4) readonly buffer Batches {
    uint batchFirstSlot[];
};

layout(std430, binding = 5) buffer Counts {
    uint counts[];
};

layout(std430, binding = 6) writeonly buffer Compacted {
    uint compacted[];
};

layout(push_constant) uniform Params {
    mat4 viewProj;
    ivec2 screenSize;
    int levels;
    int compact;
};

const uint HIDDEN = 0u;
const uint LATE = 2u;
const float MARGIN = 1.0;
const float SIZE = 16.0 + MARGIN * 2.0;

bool isVisible(vec3 origin) {
    vec3 boxMin = origin - MARGIN;
    vec2 lo = vec2(1.0);
    vec2 hi = vec2(-1.0);
    float nearest = 1.0;

    for (int i = 0; i < 8; i++) {
        vec3 corner = boxMin + vec3(i & 1, (i >> 1) & 1, (i >> 2) & 1) * SIZE;
        vec4 clip = viewProj * vec4(corner, 1.0);
        if (clip.w <= 0.0625) {
            return true;
        }

        vec3 ndc = clip.xyz / clip.w;
        lo = min(lo, ndc.xy);
        hi = max(hi, ndc.xy);
        nearest = min(nearest, ndc.z);
    }

    if (hi.x < -1.0 || hi.y < -1.0 || lo.x > 1.0 || lo.y > 1.0) {
        return true;
    }

    if (nearest <= 0.0) {
        return true;
    }

    lo = clamp(lo, -1.0, 1.0);
    hi = clamp(hi, -1.0, 1.0);

    vec2 size = vec2(screenSize);
    ivec2 pMin = ivec2(floor(vec2(lo.x * 0.5 + 0.5, 0.5 - hi.y * 0.5) * size));
    ivec2 pMax = ivec2(floor(vec2(hi.x * 0.5 + 0.5, 0.5 - lo.y * 0.5) * size));
    pMin = clamp(pMin, ivec2(0), screenSize - 1);
    pMax = clamp(pMax, ivec2(0), screenSize - 1);

    ivec2 extent = pMax - pMin + 1;
    int level = clamp(findMSB(max(extent.x, extent.y) - 1), 0, levels - 1);
    int shift = level + 1;

    ivec2 levelSize = ((screenSize - 1) >> shift) + 1;
    ivec2 tMin = min(pMin >> shift, levelSize - 1);
    ivec2 tMax = min(pMax >> shift, levelSize - 1);

    float farthest = 0.0;
    for (int y = tMin.y; y <= tMax.y; y++) {
        for (int x = tMin.x; x <= tMax.x; x++) {
            farthest = max(farthest, texelFetch(hiZ, ivec2(x, y), level).r);
        }
    }

    return nearest <= farthest;
}

shared uint words[2];

void main() {
    uint local = gl_LocalInvocationID.x;
    if (local < 2u) {
        words[local] = 0u;
    }

    barrier();

    uint i = gl_GlobalInvocationID.x;
    if (i < count) {
        vec4 section = sections[i];
        bool visible = isVisible(section.xyz);
        if (visible) {
            atomicOr(words[local >> 5], 1u << (local & 31u));
        }

        uint flags = floatBitsToUint(section.w);
        uint kind = flags & 3u;
        if (kind == HIDDEN && compact != 0) {
            if (visible) {
                uint batch = flags >> 2;
                uint dst = (batchFirstSlot[batch] + atomicAdd(counts[batch], 1u)) * 8u;
                uint src = i * 8u;
                compacted[dst] = commands[src];
                compacted[dst + 1u] = 1u;
                compacted[dst + 2u] = commands[src + 2u];
                compacted[dst + 3u] = commands[src + 3u];
                compacted[dst + 4u] = commands[src + 4u];
            }
        } else if (kind == HIDDEN || kind == LATE) {
            commands[i * 8u + 1u] = visible ? 1u : 0u;
        }
    }

    barrier();

    if (local < 2u) {
        visibility[gl_WorkGroupID.x * 2u + local] = words[local];
    }
}
